# Английская версия сайта: ricca.design/en → файл en.html (адрес в строке браузера остаётся /en,
# поэтому относительные пути img/… css/… работают как у главной). /en/ со слэшем — на /en
/en/              /en                  301
/en/index.html    /en                  301
/en               /en.html             200
# Английский конструктор: ricca.design/en/configurator — та же страница configurator.html, язык она берёт из адреса.
# Адрес остаётся /en/configurator, поэтому её файлы (css/, js/, vendor/ …) запрашиваются как /en/css/… — отдаём их из корня
/en/configurator.html  /en/configurator  301
/en/configurator  /configurator.html   200
/en/css/*         /css/:splat          200
/en/js/*          /js/:splat           200
/en/vendor/*      /vendor/:splat       200
/en/img/*         /img/:splat          200
/en/fonts/*       /fonts/:splat        200
/en/models3d/*    /models3d/:splat     200
/en/video/*       /video/:splat        200
